APP_NAME=Laravel
APP_ENV=local
SERVER_DISK_DRIVER=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Exact origin of the frontend allowed by CORS (scheme + host + port, no
# trailing slash). Required in production: there is no localhost fallback, so
# leaving it unset disables cross-origin access entirely.
FRONTEND_URL=http://localhost:5174

# Local demo domain suffix (wildcard-resolved via Acrylic DNS Proxy), e.g. sasapp
TENANT_DOMAIN_SUFFIX=sasapp

# Experimental unauthenticated path-based tenancy routes (/p/{tenant}/...).
# Local experiments only — leave false everywhere else.
TENANCY_PATH_IDENTIFICATION=false

# Admin seeding credentials — used by AdminUserSeeder and StaffSeeder
# WARNING: Change these immediately after deploy. Do not use defaults in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Tenant seeding credentials — used by Tenant/UserSeeder for all tenant users
# WARNING: MUST be set to a strong, unique value in production
TENANT_PASSWORD=CHANGE_ME_TENANT_PASSWORD

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Connection name (from config/database.php) holding the central tables.
# Central models and admin validation rules resolve it via tenancy.central_connection.
CENTRAL_DB_CONNECTION=mysql_central

# Real-time tenant email confirmation uses Reverb. Run `php artisan reverb:start`
# and keep this as `reverb`; set it to `log` to disable WebSockets (the pending
# screen still falls back to its 5-second poll).
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=true

JWT_SECRET=
JWT_ADMIN_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=1440
JWT_REFRESH_IAT=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit (bundled with Laragon; UI at http://127.0.0.1:8025)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@saas-app.test"
MAIL_FROM_NAME="${APP_NAME}"

# Production: same SMTP mailer, provider values (587=tls, 465=ssl)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@yourdomain.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
CLOUD_STORAGE_LIMIT_GB=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_MODE=test

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Reverb server credentials are generated by `php artisan reverb:install`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
